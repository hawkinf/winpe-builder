<Window x:Class="WinPEBuilder.App.ProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programa no WinPE" Icon="app.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Executável:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="ExeBox" Grid.Column="1" Margin="0,0,0,8" VerticalContentAlignment="Center" TextChanged="ExeBox_TextChanged"
                 ToolTip="Arquivo .exe, .cmd, .bat ou .com no seu PC"/>
        <Button Grid.Column="2" Content="Procurar…" Margin="8,0,0,8" Padding="12,3" Click="Browse_Click"/>

        <TextBlock Grid.Row="1" Text="Nome:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" MaxLength="60"
                 VerticalContentAlignment="Center" ToolTip="Como aparece no desktop e no menu Iniciar do WinPE"/>

        <TextBlock Grid.Row="2" Text="Categoria:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox x:Name="CategoryBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsEditable="True" Margin="0,0,0,8"
                  ToolTip="Grupo no menu Iniciar (ex.: Diagnóstico, Rede, Discos)"/>

        <TextBlock Grid.Row="3" Text="Argumentos:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="ArgumentsBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalContentAlignment="Center"
                 ToolTip="Opcional"/>

        <TextBlock Grid.Row="4" Text="Pasta no desktop:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="DesktopFolderBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" MaxLength="120" VerticalContentAlignment="Center"
                 ToolTip="Opcional: nome de uma pasta na área de trabalho que abre uma janela com os programas dela. Use / para subpastas (ex.: Ferramentas/Discos)."/>

        <CheckBox x:Name="DesktopCheck" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Content="Mostrar na área de trabalho" IsChecked="True" Margin="0,0,0,4"/>
        <CheckBox x:Name="StartMenuCheck" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Content="Mostrar no menu Iniciar" IsChecked="True" Margin="0,0,0,4"/>
        <CheckBox x:Name="CopyFolderCheck" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Content="Copiar a pasta inteira do programa (programas portáteis precisam dos arquivos vizinhos)"
                  IsChecked="True" Margin="0,0,0,4" Checked="CopyFolder_Changed" Unchecked="CopyFolder_Changed"/>
        <TextBlock x:Name="SizeText" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="90" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
