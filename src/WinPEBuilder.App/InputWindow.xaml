<Window x:Class="WinPEBuilder.App.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPE Builder" Icon="app.ico" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" MaxLength="40" VerticalContentAlignment="Center" Padding="2,3"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
