<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinPEBuilder.Core\WinPEBuilder.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinPEBuilder</AssemblyName>
    <RootNamespace>WinPEBuilder.App</RootNamespace>

    <!-- Ícone do .exe (Explorer, barra de tarefas, Alt+Tab) — gerado por scripts/make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Propriedades do arquivo (botão direito > Propriedades > Detalhes) -->
    <Version>1.0.0</Version>
    <Product>WinPE Builder</Product>
    <AssemblyTitle>WinPE Builder</AssemblyTitle>
    <Description>Gera ISO de WinPE (32/64 bits, BIOS+UEFI) com os seus arquivos e programas.</Description>
    <Company>Hawk Informática</Company>
    <Copyright>© 2026 Hawk Informática</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      O launcher (net48) é compilado junto e copiado para launcher\ ao lado do .exe (build E publish); vai para dentro do WinPE.
      GlobalPropertiesToRemove: sem isso o "dotnet publish -r win-x64" repassaria TargetFramework=net10.0-windows e o
      RuntimeIdentifier do app para o launcher, que é net48 (erro NETSDK1005).
    -->
    <ProjectReference Include="..\WinPEBuilder.Launcher\WinPEBuilder.Launcher.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishTrimmed;PublishDir" />
  </ItemGroup>

  <PropertyGroup>
    <LauncherBuilt>$(MSBuildThisFileDirectory)..\WinPEBuilder.Launcher\bin\$(Configuration)\net48\WinPELauncher.exe</LauncherBuilt>
  </PropertyGroup>

  <Target Name="CopyLauncher" AfterTargets="Build">
    <Copy SourceFiles="$(LauncherBuilt)" DestinationFolder="$(OutDir)launcher" Condition="Exists('$(LauncherBuilt)')" />
    <Warning Condition="!Exists('$(LauncherBuilt)')" Text="WinPELauncher.exe não encontrado em $(LauncherBuilt)" />
  </Target>

  <!-- dotnet publish: coloca launcher\WinPELauncher.exe na pasta de publicação (o build service procura ao lado do .exe). -->
  <Target Name="PublishLauncher" AfterTargets="ComputeResolvedFilesToPublishList" Condition="Exists('$(LauncherBuilt)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(LauncherBuilt)" RelativePath="launcher\WinPELauncher.exe" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Geometria do papel de parede: o MESMO código do launcher, para o preview sair igual ao WinPE. -->
    <Compile Include="..\WinPEBuilder.Launcher\Model\WallpaperGeometry.cs" Link="Shared\WallpaperGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmo ícone embutido como recurso para a janela (Icon="app.ico" no XAML) -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
