<Window x:Class="WinPEBuilder.App.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor visual do WinPE" Icon="app.ico" Width="1300" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Preview da tela do WinPE (1024x768, não executa nada) ===== -->
        <Border Grid.Row="0" Grid.Column="0" Background="#1B1B1B" CornerRadius="4" Padding="8">
            <Viewbox Stretch="Uniform">
                <Grid Width="1024" Height="768" ClipToBounds="True" Background="#124678">
                    <Canvas x:Name="DesktopCanvas" Width="1024" Height="726" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Background="#124678" AllowDrop="True" DragOver="Desktop_DragOver" DragLeave="Desktop_DragLeave" Drop="Desktop_Drop"
                            MouseLeftButtonDown="Desktop_MouseLeftButtonDown"/>

                    <TextBlock x:Name="EmptyHint" Text="Arraste programas (.exe) ou pastas do Explorer para cá, ou use os botões ao lado."
                               Foreground="#99FFFFFF" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" Width="560"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40" IsHitTestVisible="False"/>

                    <!-- Janela de uma pasta (abre com duplo clique no ícone de pasta) -->
                    <Border x:Name="FolderPanel" Visibility="Collapsed" Width="560" Height="340" Background="White" BorderBrush="#124678"
                            BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,120,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#10445F" Height="30">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Width="40" Margin="0" Padding="0" Background="Transparent"
                                            Foreground="White" BorderThickness="0" Click="CloseFolder_Click"/>
                                    <TextBlock x:Name="FolderTitle" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="FolderItems" Margin="6"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Barra de tarefas -->
                    <Border VerticalAlignment="Bottom" Height="42" Background="#1C202C">
                        <DockPanel>
                            <Button x:Name="StartButton" DockPanel.Dock="Left" Content="Iniciar" Width="104" Margin="0" Padding="0"
                                    Background="#0066CC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="StartButton_Click"/>
                            <TextBlock x:Name="Clock" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Width="70" TextAlignment="Center" FontSize="12"/>
                            <TextBlock Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                       Text="(os programas abertos aparecem aqui)"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Border>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="2,8,0,0" TextWrapping="Wrap" Foreground="Gray" x:Name="HintText"
                   Text="Preview: nada é executado aqui. Arraste os ícones para mover (soltar sobre outro ícone troca de lugar; sobre uma pasta, coloca dentro). Duplo clique edita ou abre a pasta. Delete remove. Clique em Iniciar para ver o menu."/>

        <!-- ===== Painel de controle ===== -->
        <TabControl Grid.Row="0" Grid.Column="2">
            <TabItem Header="Programas">
        <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Programas" FontWeight="SemiBold" Margin="0,0,0,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Adicionar programa…" Click="AddProgram_Click"/>
                <Button Content="Adicionar pasta de programas…" Click="AddFolder_Click"/>
                <Button x:Name="EditButton" Content="Editar…" IsEnabled="False" Click="Edit_Click"/>
                <Button x:Name="RemoveButton" Content="Remover" IsEnabled="False" Click="Remove_Click"/>
                <Button Content="Reorganizar ícones" Click="AutoArrange_Click" ToolTip="Arruma todos os ícones em ordem alfabética"/>
                <Button Content="Papel de parede…" Click="Wallpaper_Click" ToolTip="Escolher a imagem ou a cor de fundo da área de trabalho"/>
            </StackPanel>
            <ListBox x:Name="ProgramList" SelectionMode="Single" SelectionChanged="ProgramList_SelectionChanged"
                     MouseDoubleClick="ProgramList_DoubleClick" PreviewMouseLeftButtonDown="ProgramList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ProgramList_PreviewMouseMove" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
            </TabItem>
            <TabItem Header="Menu Iniciar">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                               Text="Arraste para reordenar. Soltar um programa sobre uma categoria muda a categoria dele. Ou use Subir/Descer."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Subir" Width="90" Margin="0,0,8,0" Click="MenuUp_Click"/>
                        <Button Content="Descer" Width="90" Click="MenuDown_Click"/>
                    </StackPanel>
                    <TreeView x:Name="MenuTree" AllowDrop="True" PreviewMouseLeftButtonDown="MenuTree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="MenuTree_PreviewMouseMove" DragOver="MenuTree_DragOver" Drop="MenuTree_Drop"
                              SelectedItemChanged="MenuTree_SelectedItemChanged"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ===== Gravar / Descartar ===== -->
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="DirtyText" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="DarkOrange" FontSize="11"/>
            <Button x:Name="SaveButton" Content="Gravar" FontWeight="Bold" Padding="22,6" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Descartar" Padding="16,6" Margin="0" Click="Discard_Click"/>
        </StackPanel>
    </Grid>
</Window>
