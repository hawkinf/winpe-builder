<Window x:Class="WinPEBuilder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPE Builder" Icon="app.ico" Height="780" Width="1120" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,16,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="520"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Configuração ===== -->
        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <StackPanel x:Name="ConfigPanel">

                <GroupBox Header="1. Requisitos (Windows ADK)">
                    <StackPanel>
                        <TextBlock x:Name="DeploymentToolsText" Margin="0,2"/>
                        <TextBlock x:Name="WinPeX64Text" Margin="0,2"/>
                        <TextBlock x:Name="WinPeX86Text" Margin="0,2"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="RefreshButton" Content="Verificar novamente" Click="RefreshButton_Click"/>
                            <Button x:Name="InstallX64Button" Content="Instalar ADK (64 bits)" Click="InstallX64Button_Click"/>
                            <Button x:Name="InstallX86Button" Content="Instalar ADK Win10 2004 (32 bits)" Click="InstallX86Button_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. Tipo de WinPE">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Arquitetura:" Width="90" VerticalAlignment="Center"/>
                            <RadioButton x:Name="ArchX64Radio" Content="64 bits (x64)" GroupName="arch" IsChecked="True" Checked="Option_Changed"/>
                            <RadioButton x:Name="ArchX86Radio" Content="32 bits (x86)" GroupName="arch" Checked="Option_Changed"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Origem:" Width="90" VerticalAlignment="Center"/>
                            <RadioButton x:Name="SourceAdkRadio" Content="WinPE oficial do ADK (recomendado)" GroupName="source" IsChecked="True" Checked="Option_Changed"/>
                            <RadioButton x:Name="SourceIsoRadio" Content="boot.wim de uma ISO do Windows" GroupName="source" Checked="Option_Changed"/>
                        </WrapPanel>
                        <Grid x:Name="IsoSourcePanel" Margin="0,6,0,0" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IsoPathBox" VerticalContentAlignment="Center" ToolTip="ISO de instalação do Windows com a MESMA arquitetura escolhida"/>
                            <Button x:Name="IsoBrowseButton" Grid.Column="1" Content="Procurar…" Margin="8,0,0,0" Click="IsoBrowseButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="SourceHint" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. Pacotes opcionais (só com origem ADK)">
                    <WrapPanel x:Name="ComponentsPanel"/>
                </GroupBox>

                <GroupBox Header="4. Ajustes">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Teclado:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="KeyboardBox" Grid.Column="1" IsEditable="True" Margin="0,0,16,0">
                            <ComboBoxItem Content="pt-BR"/>
                            <ComboBoxItem Content="pt-PT"/>
                            <ComboBoxItem Content="en-US"/>
                            <ComboBoxItem Content="es-ES"/>
                        </ComboBox>
                        <TextBlock Text="Rótulo da ISO:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="LabelBox" Grid.Column="3" MaxLength="32" VerticalContentAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="5. Seus arquivos (opcional)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilesFolderBox" VerticalContentAlignment="Center" ToolTip="Deixe vazio para não incluir arquivos"/>
                            <Button x:Name="FilesBrowseButton" Grid.Column="1" Content="Procurar…" Margin="8,0,0,0" Click="FilesBrowseButton_Click"/>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton x:Name="FilesOnIsoRadio" Content="Na ISO (recomendado, não usa RAM)" GroupName="files" IsChecked="True"/>
                            <RadioButton x:Name="FilesInsideRadio" Content="Dentro da imagem (RAM, até 1 GB)" GroupName="files"/>
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                                   Text="No WinPE os arquivos aparecem na unidade Z: e na variável %ARQUIVOS%. Se existir um startup.cmd na pasta, ele roda sozinho ao iniciar."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="6. Programas no WinPE (desktop e menu Iniciar)">
                    <StackPanel>
                        <ListView x:Name="ProgramsList" Height="130" SelectionMode="Single" MouseDoubleClick="ProgramsList_DoubleClick"
                                  SelectionChanged="ProgramsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nome" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Categoria" Width="90" DisplayMemberBinding="{Binding Category}"/>
                                    <GridViewColumn Header="Aparece em" Width="110" DisplayMemberBinding="{Binding Where}"/>
                                    <GridViewColumn Header="Arquivo" Width="170" DisplayMemberBinding="{Binding File}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button x:Name="DesignerButton" Content="Abrir editor visual…" FontWeight="Bold" Padding="16,7" HorizontalAlignment="Left"
                                ToolTip="Mostra como o desktop e o menu Iniciar do WinPE vão ficar (sem executar nada). Arraste, adicione e remova; depois grave ou descarte."
                                Click="DesignerButton_Click" Margin="0,8,0,4"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="ProgramAddButton" Content="Adicionar programa…" Click="ProgramAddButton_Click"/>
                            <Button x:Name="ProgramAddFolderButton" Content="Adicionar pasta…" Click="ProgramAddFolderButton_Click"/>
                            <Button x:Name="ProgramEditButton" Content="Editar…" IsEnabled="False" Click="ProgramEditButton_Click"/>
                            <Button x:Name="ProgramRemoveButton" Content="Remover" IsEnabled="False" Click="ProgramRemoveButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="ProgramsSummary" TextWrapping="Wrap" Foreground="Gray"/>
                        <TextBlock x:Name="ProgramsHint" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="7. ISO de saída">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputBox" VerticalContentAlignment="Center"/>
                        <Button x:Name="OutputBrowseButton" Grid.Column="1" Content="Salvar como…" Margin="8,0,0,0" Click="OutputBrowseButton_Click"/>
                    </Grid>
                </GroupBox>

              </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel x:Name="ActionsPanel" Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="BuildButton" Content="Gerar ISO" FontWeight="Bold" Padding="24,6" Click="BuildButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Click="CancelButton_Click"/>
            <Button x:Name="UsbButton" Content="Gravar em pendrive…" IsEnabled="False" Click="UsbButton_Click"/>
            <Button x:Name="OpenFolderButton" Content="Abrir pasta da ISO" IsEnabled="False" Click="OpenFolderButton_Click"/>
        </WrapPanel>
        </Grid>

        <!-- ===== Andamento e log ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Text="Pronto." FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Grid.Row="1" Height="14" Minimum="0" Maximum="1"/>
            <GroupBox Header="Log" Grid.Row="2" Margin="0,10,0,0" Padding="6">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
