<Window x:Class="WinPEBuilder.App.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Papel de parede" Icon="app.ico" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Preview exato (mesma geometria do launcher) -->
        <Border Grid.ColumnSpan="4" Background="#1B1B1B" Padding="6" Margin="0,0,0,12" HorizontalAlignment="Center">
            <Image x:Name="PreviewImage" Width="480" Height="340" Stretch="Fill"/>
        </Border>

        <TextBlock Grid.Row="1" Text="Imagem:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="ImageBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,0,8"
                 ToolTip="JPG, PNG ou BMP (até 25 MB). A imagem é copiada para a mídia."/>
        <Button Grid.Row="1" Grid.Column="2" Content="Escolher…" Margin="8,0,0,8" Padding="12,3" Click="Choose_Click"/>
        <Button x:Name="RemoveImageButton" Grid.Row="1" Grid.Column="3" Content="Remover" Margin="6,0,0,8" Padding="12,3" Click="RemoveImage_Click"/>

        <TextBlock Grid.Row="2" Text="Modo:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox x:Name="ModeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" SelectionChanged="Option_Changed">
            <ComboBoxItem Content="Preencher (cobre a tela, corta o que sobrar)" Tag="Fill"/>
            <ComboBoxItem Content="Ajustar (cabe inteira, sobram faixas)" Tag="Fit"/>
            <ComboBoxItem Content="Esticar (pode deformar)" Tag="Stretch"/>
            <ComboBoxItem Content="Centralizar (tamanho original)" Tag="Center"/>
            <ComboBoxItem Content="Lado a lado (mosaico)" Tag="Tile"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Cor de fundo:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="ColorBox" Width="90" MaxLength="7" VerticalContentAlignment="Center" TextChanged="Option_Changed"
                     ToolTip="Formato #RRGGBB"/>
            <Border x:Name="ColorSwatch" Width="28" Height="24" Margin="8,0,12,0" BorderBrush="Gray" BorderThickness="1"/>
            <WrapPanel x:Name="Presets"/>
        </StackPanel>

        <TextBlock x:Name="InfoText" Grid.Row="4" Grid.ColumnSpan="4" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Restaurar padrão" Padding="12,4" Margin="0,0,24,0" Click="Reset_Click"/>
            <Button Content="OK" Width="90" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
