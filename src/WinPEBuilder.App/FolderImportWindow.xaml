<Window x:Class="WinPEBuilder.App.FolderImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar pasta de programas" Icon="app.ico" Width="760" Height="600" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pasta:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center" IsReadOnly="True"
                     ToolTip="A pasta inteira é copiada UMA vez para o WinPE; os programas abaixo apontam para dentro dela"/>
            <Button Grid.Column="2" Content="Procurar…" Margin="8,0,0,0" Padding="12,3" Click="Browse_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Categoria no menu Iniciar:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="CategoryBox" Grid.Column="1" MaxLength="40" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ShowFolderCheck" VerticalAlignment="Center" Margin="0,0,10,0"
                      Content="Colocar esta pasta na área de trabalho (abre uma janela com todos os programas marcados):"
                      Checked="ShowFolder_Changed" Unchecked="ShowFolder_Changed"/>
            <TextBox x:Name="FolderNameBox" Grid.Column="1" MaxLength="40" VerticalContentAlignment="Center" IsEnabled="False"/>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
            <Button Content="Marcar todos" Padding="10,3" Margin="0,0,6,0" Click="IncludeAll_Click"/>
            <Button Content="Desmarcar todos" Padding="10,3" Margin="0,0,6,0" Click="IncludeNone_Click"/>
            <Button Content="Todos no menu Iniciar" Padding="10,3" Margin="0,0,6,0" Click="AllStartMenu_Click"/>
            <Button Content="Todos na área de trabalho" Padding="10,3" Margin="0,0,6,0" Click="AllDesktop_Click"/>
        </WrapPanel>

        <DataGrid x:Name="Grid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Programa (dentro da pasta)" Binding="{Binding RelativePath}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Nome exibido" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                <DataGridCheckBoxColumn Header="Menu Iniciar" Binding="{Binding StartMenu, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridCheckBoxColumn Header="Área de trabalho" Binding="{Binding Desktop, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="InfoText" Grid.Row="5" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="Gray"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Adicionar" Width="100" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
