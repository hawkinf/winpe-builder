<Window x:Class="WinPEBuilder.App.UsbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gravar em pendrive" Icon="app.ico" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="Firebrick"
                   Text="ATENÇÃO: o pendrive escolhido será FORMATADO e todos os dados dele serão apagados."/>
        <TextBlock Text="Pendrive:" Margin="0,12,0,4"/>
        <ComboBox x:Name="DriveBox" SelectionChanged="Input_Changed"/>
        <TextBlock Margin="0,12,0,4" TextWrapping="Wrap"
                   Text="Para confirmar, digite a letra do pendrive (ex.: E):"/>
        <TextBox x:Name="ConfirmBox" MaxLength="2" Width="60" HorizontalAlignment="Left" TextChanged="Input_Changed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Formatar e gravar" Padding="14,5" Margin="0,0,8,0" IsEnabled="False" Click="OkButton_Click"/>
            <Button Content="Cancelar" Padding="14,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
